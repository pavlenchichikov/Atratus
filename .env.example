# Скопируй в .env и заполни:
#   cp .env.example .env

# Телеграм-бот (создаётся через @BotFather)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id_here

# SOCKS5-прокси для исходящих запросов. Пусто = напрямую.
SOCKS5_PROXY=
# Режим прокси: auto (проба) | on | off
GTRADE_PROXY_MODE=auto

# Проверка TLS-сертификатов. По умолчанию включена,
# ставь 0 только если прокси перехватывает TLS.
GTRADE_SSL_VERIFY=1

# Час отправки утреннего дайджеста ботом
GTRADE_DIGEST_HOUR=9

# Atratus live-signals push (push_signals.py) - service key is SECRET, local only
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Path to the Firebase service-account JSON for mobile push notifications
# (secret - keep outside git). Leave unset to skip pushes entirely.
GTRADE_FCM_CREDS=

# Optional: path to the Flutter client tree, used only by the digest parity test
# to verify its fixture copy is in sync. Unset means that check skips.
GTRADE_MOBILE_DIR=

# Live-accuracy gate (core/live_gate.py); 0 disables
GTRADE_LIVE_GATE=1
# GTRADE_LIVE_GATE_DAYS=45
# GTRADE_LIVE_GATE_MIN_ACC=0.45
# GTRADE_LIVE_GATE_MIN_N=100
# GTRADE_LIVE_GATE_ASSET_ACC=0.40
# GTRADE_LIVE_GATE_ASSET_N=20
# GTRADE_LIVE_GATE_TAIL=0.85
# GTRADE_LIVE_RECAL_MIN_N=300

# Auto-research tuning axes + tier ladder
# GTRADE_THR_MARGIN=0
# GTRADE_BAND_DELTA=0
# GTRADE_REGIME_MODE=both
# GTRADE_AR_TIER=1
# GTRADE_AR_TIER_ASSETS=SP500,BTC,EURUSD,GOLD
# GTRADE_AR_TIER_MIN=0.0

# LLM providers. The launcher offers three ([RS], [AL], [AN]); the SDKs read
# these names themselves, so a key here is all that is needed.
#   anthropic -> ANTHROPIC_API_KEY   (console.anthropic.com)
#   openai    -> OPENAI_API_KEY      (platform.openai.com)
#   ollama    -> neither; it talks to a local model over HTTP and is free
# GTRADE_AR_LLM picks which one, GTRADE_AR_LLM_MODEL the exact model id.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# How many tokens ONE analyst judgment may spend. A reasoning model writes its
# trace before the answer, so a cap the trace uses up returns empty content
# after the full wait - measured 2026-09-18, 0 chars after 2031 seconds at the
# 8000 the search runs on. The analyst asks with the reasoning trace OFF, so a
# judgment is a small JSON object and 8000 (the default here) fits it several
# times over. 0/none/unlimited removes the cap, but a model that ignores the
# no-trace flag then runs to the timeout instead - gemma4:26b does exactly that.
GTRADE_ANALYST_MAX_TOKENS=8000

# Does the analyst reason before it judges? 1 = yes (default). Every Ollama call
# now goes to Ollama's own /api/chat, which returns the trace and the answer in
# SEPARATE fields, so a trace that runs long is reported as such instead of
# arriving as an empty judgment. Set 0 if a model spends its whole budget
# thinking - the run then says so and stops rather than asking again.
GTRADE_ANALYST_THINK=1

# RL search controller for auto_research (emitter/scheduler).
# 1 = learn budget allocation over child sources; unset/0 = classic uniform search.
GTRADE_AR_RL=0

# Stage-A timing policy (entry/exit rules over ensemble signals).
# 1 = compute shadow timing decisions at serve (recorded, not displayed).
GTRADE_TIMING_POLICY=0
# Which timing policy the shadow records when the line above is 1.
# Unset or anything else = the adopted Stage-A rules. b = the fitted
# Q. Shadow either way: neither ever changes the signal, both are
# logged beside it and read back per stage by [PS].
GTRADE_TIMING_STAGE=

# Head-only epochs at fold 1 before unfreezing (0 = off).

# Selection objective v2 (position-aware costs, daily Sharpe, vol-scaled cap)
# Off by default; flip only via the ab_objective.py A/B verdict + full retrain.
# GTRADE_OBJECTIVE_V2=0
