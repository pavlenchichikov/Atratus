# Credentials & secrets
.env

# Internal docs
docs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/

# ML models (binary, too large for git)
*.pkl
*.h5
*.keras
*.cbm
models/
hybrid_models/
index_models/

# Data & databases
*.db
*.db-journal
*.db-wal
*.db-shm
market_data/

# Logs
*.log
*.log.*
catboost_info/

# Safety copies taken before editing local research state (_ar_tried.json and
# friends). They hold the same strategy data as the originals, so they must not
# reach a public remote either.
*.bak

# Half-written state from the atomic writers, named "<file>.<pid>.tmp" (see
# core/ar_progress._write). They are cleaned up on a failed write, but a process
# that is KILLED never runs that cleanup, so one is left in the worktree every
# time a run is stopped the hard way. Same content as the file it was becoming,
# so it must not reach a public remote either.
*.tmp

# Backups & exports
backups/
exports/
backtest_results*.pkl

# Generated HTML reports (performance_report.py)
reports/

# Scheduler state
scheduler_state.json

# Self-maintaining loop runtime artifacts (generated at deploy time, not code)
loop_state.json
_loop.lock
_auto_loop.lock
_auto_loop.stop
_auto_loop_report.txt

# All JSON is runtime/generated state (logs, champion registry, quality reports,
# app config, agent state). Only the *.example.json seeds (hand-edited config
# templates) stay tracked; live config is seeded from them on a fresh clone.
*.json
!*.example.json

# The journal maintenance pass writes its result beside the original as
# <name>.json.new and keeps a dated copy of both files, so neither is caught by
# the *.json rule above.
*.json.new
_journal_backup/

# Test fixtures are hand-written inputs, not generated state: keep them tracked.
!tests/fixtures/*.json

# Internal docs (outdated)
PLAN.md


# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

