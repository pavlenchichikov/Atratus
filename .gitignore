check_nets.bat
ab_netfix.py
ab_proxy_check.py
ab_objective_v2.py
# companion test of the local ab_labeling.py: keep it out of Git too, else CI
# checks out the test without the module and the unguarded import fails collection.
tests/test_ab_labeling.py
tests/test_ab_objective.py
tests/test_ab_noise.py
# Fitted levels policy and its run report: the policy is the edge, same
# reasoning as adopted_genome.json, and the report is local run state.
levels_policy.json
_levels_report.txt
_chunk_progress.txt
_chunk_quality.json
_auto_features.json
_auto_research_log.json
_auto_research_state.json
_qd_archive.json
# Research wiki: distilled findings, private - must not be public
_ar_wiki/

# batfiles
train_adaptive.bat



# Scratch list handed from the base-env health check to the GPU-env trainer.
_repair_list.txt

# Search-gate list handed from ab_build to the launcher.
_search_gate.txt

# Held patches: work prepared while a training run is in flight, applied by
# hand once it ends. Local by nature, like the ab_* harnesses.
*.patch
